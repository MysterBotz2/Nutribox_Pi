# Production Pi configuration. Replace only the example HTTPS hostname.
NUTRIBOX_API_BASE_URL=https://api.example.invalid
NUTRIBOX_HTTP_TIMEOUT_SECONDS=10

# Camera Module 3 supplied by Raspberry Pi OS; never install Picamera2 with pip.
NUTRIBOX_CAMERA_ADAPTER=picamera2

# Mounted JC5 5 kg load cell through HX711. These are BCM GPIO numbers, not
# physical header-pin numbers.
NUTRIBOX_WEIGHT_ADAPTER=hx711
NUTRIBOX_HX711_DATA_BCM=5
NUTRIBOX_HX711_CLOCK_BCM=6
NUTRIBOX_HX711_SAMPLE_COUNT=5
NUTRIBOX_HX711_STABILITY_TOLERANCE_GRAMS=2.0
NUTRIBOX_HX711_NEGATIVE_NOISE_CLAMP_GRAMS=2.0

# Retained only for explicit Windows/CI development configuration.
# NUTRIBOX_CAMERA_ADAPTER=simulated
# NUTRIBOX_WEIGHT_ADAPTER=simulated
# NUTRIBOX_SIMULATED_WEIGHT_GRAMS=250
NUTRIBOX_SIMULATED_TEMPERATURE_C=25
